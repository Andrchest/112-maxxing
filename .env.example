# Copy to .env and adjust for local development. All values below are fake/dev placeholders —
# never put a real secret in this file (see docs/hld/00-decisions.md D1, SPEC §41).

# `make dev-infra-up` (infra/docker-compose.yml) publishes PostgreSQL on 15432 and Redis on 16379,
# so the development stack can run beside the test stack (55432 / 56379) and beside any system
# PostgreSQL on 5432.
SIM_DATABASE_URL=postgresql+asyncpg://sim:sim@localhost:15432/sim
SIM_REDIS_URL=redis://localhost:16379/0
# >= 32 bytes or Settings refuses to load (SPEC §41, E18-A R3) — this placeholder is long enough
# to pass that check but is still not a real secret; generate a real one for anything that leaves
# this machine.
SIM_JWT_SECRET=dev-only-change-me-not-a-real-secret
# Bearer-token lifetime in minutes (D8). 720 = twelve hours: longer than a training day.
SIM_JWT_TTL_MINUTES=720

# --- HTTP API (D8, SPEC §41) ---------------------------------------------------------------
# Loopback by default: the backend is a local system and is not exposed to the network.
# The port is 8100 and not 8000/8001 — see the E7-A task report.
SIM_API_HOST=127.0.0.1
SIM_API_PORT=8100
# Exact origins only, never `*`: the API is credentialed. The Vite dev server (D12).
SIM_CORS_ALLOW_ORIGINS=["http://localhost:5173"]
# Which CallTransportStatus adapter is wired (D9): "fake" | "livekit".
# "fake" is always ready (no SFU, no voice-agent). "livekit" answers `ring`'s guard for real: the
# LiveKit server must be reachable AND the voice-agent heartbeat `voice:health:vad` must be READY.
SIM_CALL_TRANSPORT=fake
# D7's SimulationRunner. Set false to run the API without any background tick task.
SIM_RUNNER_ENABLED=true

# --- Seed accounts (`make seed-users`, SPEC §41) ---------------------------------------------
# Fake placeholders. Never a real password, and never a default in source: `app.tools.seed_users`
# refuses to run when one of these is unset.
SIM_SEED_TRAINEE_PASSWORD=dev-trainee-change-me
SIM_SEED_INSTRUCTOR_PASSWORD=dev-instructor-change-me
SIM_SEED_ADMIN_PASSWORD=dev-admin-change-me
SIM_DATA_DIR=data
SIM_REQUIRE_INFERENCE_READY=true
SIM_SIM_TICK_MS=500
SIM_MODEL_PROFILE=DEV_3060TI
SIM_RECORDING_RETENTION_DAYS=30
# --- LiveKit (D9, SPEC §15) -------------------------------------------------------------------
# The URL THIS PROCESS dials. Under `make dev-infra-up` the SFU is published on localhost; under
# the full compose stack (`make up`, E18-E) `infra/docker-compose.yml` overrides this to
# `ws://livekit:7880` for the `backend`/`voice-agent` containers — this value is what a HOST run
# (`make run-api`/`make run-voice-agent`) uses instead.
SIM_LIVEKIT_URL=ws://localhost:7880
# The URL a BROWSER dials, which is not always the one above: a container-internal host name does
# not resolve on the trainee's machine. `VoiceTokenResponse.livekit_url` carries this value.
# Leave it empty to mean "the same as SIM_LIVEKIT_URL", which is what a local run wants.
SIM_LIVEKIT_PUBLIC_URL=
# Fake dev placeholders. `infra/docker-compose.yml` passes these to the SFU as LIVEKIT_KEYS, and
# the backend signs its access tokens with the same secret (SPEC §41: never a real one here).
SIM_LIVEKIT_API_KEY=devkey
SIM_LIVEKIT_API_SECRET=devsecret1234567890
# Lifetime of a minted LiveKit access token, in minutes (`createVoiceToken`).
SIM_LIVEKIT_TOKEN_TTL_MINUTES=10
# §40.6: how often the backend re-publishes `voice:join` until the agent's first event (E20 R2).
SIM_VOICE_JOIN_RETRY_MS=2000
# Where a HOST-run process dials llama-server: `make run-llama-server` listens on
# LLAMA_SERVER_HOST:LLAMA_SERVER_PORT (Makefile, default 127.0.0.1:8180). Under `make up` compose
# pins `http://llama-server:8080/v1` in the containers' own environment, so this line is host-only.
SIM_LLM_BASE_URL=http://127.0.0.1:8180/v1
# --- Model files root (E20 R15) -----------------------------------------------------------------
# Where THIS process finds the files a model profile names under `/models/...`. Containers get
# `/models` pinned in infra/docker-compose.yml (the mounted volume); a host-run process (`make
# run-voice-agent`, `make preflight`, the benchmarks) needs the repo's `models/` directory:
# uncomment for a host run. `make models-layout` lays `models/` out the way the profiles expect.
#SIM_MODELS_ROOT=./models

# --- VAD and ASR providers (E12; `60-inference-ops.md` §1, SPEC §19) ---------------------------
# The ONLY place a model is named. `energy` + `fake` is what `make gate` runs (D13): no weights,
# no GPU, deterministic. Every model profile selects `silero` + `gigaam`.
# `energy` | `silero`
SIM_VAD_PROVIDER=energy
# COMMENTED OUT (E20-G): an explicitly-set SIM_* value WINS over the active model profile
# (`app.config.profile.apply_profile`, HLD 60 §2.0), so a host-relative `models/...` here
# overrode the profile's container path inside EVERY compose container and the voice agent
# died with `ModelNotAvailableError: GigaAM checkpoint not found at models/gigaam-v3-e2e_ctc`
# on the documented `make up` path. Leave these unset: the profile names the paths, and
# SIM_MODELS_ROOT above maps them onto this host for a `make run-*` run (E20 R15).
#SIM_VAD_MODEL_PATH=models/silero-vad/silero_vad.onnx
# `fake` | `gigaam` | `faster_whisper`
SIM_ASR_PROVIDER=fake
# GigaAM v3: `v3_e2e_ctc` (primary) or `v3_ctc` (benchmarked). The version and the directory go
# together — `v3_ctc` pairs with `models/gigaam-v3-ctc`.
SIM_ASR_MODEL_VERSION=v3_e2e_ctc
#SIM_ASR_MODEL_DIR=models/gigaam-v3-e2e_ctc
# Profile-owned (E20): an explicitly-set value WINS over SIM_MODEL_PROFILE (HLD 60 §2.0), so it stays commented; uncomment only to override the profile on purpose.
#SIM_ASR_DEVICE=cuda
# Profile-owned (E20): an explicitly-set value WINS over SIM_MODEL_PROFILE (HLD 60 §2.0), so it stays commented; uncomment only to override the profile on purpose.
#SIM_ASR_COMPUTE_TYPE=float16
# One `transcribe()` past this is a `MODEL_ERROR{TIMEOUT}` and a quiet end to the turn (SPEC §42
# item 14). §8 budgets 250 ms for ASR, so this is "wedged", not "slow".
SIM_ASR_TIMEOUT_MS=4000
# A real Russian WAV for the ASR warm-up (`60-inference-ops.md` §4.2). Empty = synthesise a tone,
# and a tone transcribes to nothing — which is why preflight check 5 (SPEC §38) was red on a
# healthy stack until E20-G. `models/warmup/warmup_ru.wav` (E19-F) is the same file every model
# profile's `warmup.asr_sample_path` already names; check 5 now requires a Cyrillic word back.
# Relative to SIM_MODELS_ROOT/the repo root; under compose the mounted path is /models/warmup/….
SIM_ASR_WARMUP_SAMPLE_PATH=models/warmup/warmup_ru.wav
# --- Local LLM: interpreter + generator (E13; D10, SPEC §20-§22, §41) --------------------------
# `fake` | `llama_cpp`. `fake` is what `make gate` runs (D13, no GPU, deterministic).
SIM_LLM_PROVIDER=fake
# Profile-owned (E20): an explicitly-set value WINS over SIM_MODEL_PROFILE (HLD 60 §2.0), so it stays commented; uncomment only to override the profile on purpose.
#SIM_LLM_MODEL_NAME=Qwen3-4B
SIM_LLM_N_CTX=4096
# `make models-llm` fetches this file; `LlamaCppClient` itself never opens it — it only dials
# SIM_LLM_BASE_URL, which must stay loopback or a compose-internal host name (SPEC §41).
#SIM_LLM_MODEL_PATH=models/Qwen3-4B-Q4_K_M.gguf
# JSON list of compose-internal service names `validate_llm_base_url` accepts besides loopback.
SIM_LLM_ALLOWED_INTERNAL_HOSTS=["llama-server"]
# §5.1/§5.3 interpreter call params. MAX_TOKENS is the eval set's measured p99 completion-token
# count (110.3, compact JSON + grammar, n=148 across 4 models) + 25%, rounded up to 138
# (E13-B3 CHANGE item 4) — see benchmarks/results/interpreter_eval/20260921T180708Z/.
SIM_LLM_INTERPRETER_MAX_TOKENS=138
# Profile-owned (E20): an explicitly-set value WINS over SIM_MODEL_PROFILE (HLD 60 §2.0), so it stays commented; uncomment only to override the profile on purpose.
#SIM_LLM_INTERPRETER_TIMEOUT_MS=2500
# GBNF grammar (generated) vs response_format=json_schema for the interpreter (E13-B3 item 1).
SIM_LLM_INTERPRETER_USE_GRAMMAR=true
# §5.2/§5.3 caller-generator call params (E13-B2).
SIM_LLM_GENERATOR_MAX_TOKENS=80
SIM_LLM_GENERATOR_TIMEOUT_MS=3000
SIM_LLM_GENERATOR_TEMPERATURE=0.7
SIM_LLM_GENERATOR_TOP_P=0.9
# GBNF grammar (generated) vs response_format=json_schema for the generator (E13-B4 item 3).
SIM_LLM_GENERATOR_USE_GRAMMAR=true

# E14-A — the TTS stage (§2.4, §6, §8; SPEC §18, §19, §25; INV 12, INV 14).
# `fake` is the gate's provider (D13); the GPU default and the CPU fallback are E14-B's.
SIM_TTS_PROVIDER=fake
# The provider the whole utterance is retried on once after a failure; `none` = no retry, the
# turn then ends silent but complete (INV 14).
# COMMENTED OUT (E20-G): set explicitly, this OVERRODE every model profile's own
# `tts.fallback_provider` (DEV_3060TI's is `piper`), so a real run shipped with INV 14's retry
# disabled and a single TTS failure meant a silent caller. Left unset, the profile decides; the
# gate does not read this file at all (`SIM_ENV_FILE=` in the Makefile) and `Settings`' own
# default is still `none`.
#SIM_TTS_FALLBACK_PROVIDER=none
# TtsVoiceSpec defaults, used when a session's scenario has no CallerProfile to read them from.
# The voice id is UNVERIFIED (60-inference-ops.md §10 open item 4).
# Profile-owned (E20): an explicitly-set value WINS over SIM_MODEL_PROFILE (HLD 60 §2.0), so it stays commented; uncomment only to override the profile on purpose.
#SIM_TTS_VOICE_ID=ru_female_1
SIM_TTS_SPEAKING_RATE=1.0
# ADDITIVE (E20-G): a scenario's `caller_profile.voice_id` is a SCENARIO-LOGICAL casting decision
# (`ru_female_adult_01`), not a provider voice name. The active model profile's `tts.voice_map` /
# `tts.default_voice` map it onto the selected provider's NATIVE voice; these two variables
# override that table. SIM_TTS_VOICE_MAP is a JSON object. An unmapped logical id resolves to
# SIM_TTS_DEFAULT_VOICE with one warning — never an error. Empty here: the profile supplies both.
#SIM_TTS_VOICE_MAP={"ru_female_adult_01": "Serena"}
#SIM_TTS_DEFAULT_VOICE=Serena
# "The provider is wedged" (whole utterance) and §8 row 8's first-audio guard.
# Profile-owned (E20-I): a whole-utterance provider (Qwen3-TTS) needs guards sized from its measured
# first-audio latency (DEV_3060TI: 12000 / 15000 ms); set explicitly, these beat the profile and
# every Qwen3-TTS turn times out at 1500 ms. Settings' defaults (8000 / 1500) apply when unset.
#SIM_TTS_TIMEOUT_MS=8000
#SIM_TTS_FIRST_CHUNK_TIMEOUT_MS=1500
# split_for_tts: the length above which a sentence is subdivided at clause separators.
SIM_TTS_MAX_UNIT_CHARS=120

# E14-B — the real TTS providers (OWNER DECISION: Qwen3-TTS GPU default; PiperTTS CPU fallback).
# Qwen3TTS's httpx client target — the standalone workers/tts_qwen3 worker, loopback only.
SIM_TTS_QWEN3_BASE_URL=http://127.0.0.1:8112
# Bind host of the standalone worker itself. Loopback on a host run — the worker is never meant
# to be reachable from outside the machine. `infra/docker-compose.yml`'s `tts-qwen3` service sets
# it to 0.0.0.0 so `voice-agent` can reach it over the compose network; that service publishes no
# host port, so nothing is exposed either way (HLD 60 §9).
SIM_TTS_QWEN3_HOST=127.0.0.1
# The worker process (its own venv) reads this directly; make models-tts-qwen3 fetches into it.
#SIM_TTS_QWEN3_MODEL_DIR=models/qwen3-tts
# Vendor CustomVoice speaker Qwen3TTS falls back to when TtsVoiceSpec.voice_id is empty:
# "Serena" | "Ryan" | "Vivian" | "Aiden" only (recon §1.1).
SIM_TTS_QWEN3_SPEAKER=Serena
# PiperTTS's .onnx voice file (+ sibling .onnx.json), fetched by `make models-piper`.
#SIM_TTS_PIPER_VOICE_PATH=models/piper/ru_RU-irina-medium.onnx
# ADDITIVE (E20-E R11): tts.device/output_sample_rate and vad.device had no Settings field before
# (a provider constructor reads them now). SIM_TTS_QWEN3_MODEL is the SAME variable the standalone
# tts_qwen3 worker process already reads directly (Settings.tts_model_variant is aliased onto it)
# — one name, two readers.
# Profile-owned (E20): an explicitly-set value WINS over SIM_MODEL_PROFILE (HLD 60 §2.0), so it stays commented; uncomment only to override the profile on purpose.
#SIM_TTS_DEVICE=cuda
# Profile-owned (E20): an explicitly-set value WINS over SIM_MODEL_PROFILE (HLD 60 §2.0), so it stays commented; uncomment only to override the profile on purpose.
#SIM_TTS_OUTPUT_SAMPLE_RATE=24000
SIM_VAD_DEVICE=cpu
# Profile-owned (E20): the variant comes from SIM_MODEL_PROFILE's tts.model_variant (DEV_3060TI:
# 0.6B, measured; 1.7B does not fit its VRAM budget with the LLM on the GPU). Set only to override.
#SIM_TTS_QWEN3_MODEL=1.7B

# E13-B2 — the caller prompt builder and the deterministic response validator (§5.2, §5.3, §7).
# The turn window is SPEC §22's "last ~4-6 turns"; 4-6 is the valid range.
SIM_DIALOGUE_WINDOW_TURNS=6
# §7.1's character guard (also CALLER_JSON_SCHEMA's maxLength) and SPEC §23's "one short reply".
SIM_CALLER_MAX_CHARS=400
SIM_CALLER_MAX_SENTENCES=3
# §5.3: a prompt over this budget is refused outright and the deterministic fallback answers.
SIM_CALLER_PROMPT_TOKEN_BUDGET=2700

# E16-B — the optional score-explanation LLM call (SPEC §2, §29, §41; D11). A second, independent
# LLMClient the BACKEND process itself builds and calls (generateReportExplanation is a backend
# HTTP route, not a voice-agent turn-loop call) — see app.inference.llm.explanation_client.
# `fake` is the gate's provider (D13); `llama_cpp` is loopback/compose-internal only (SPEC §41).
SIM_EXPLANATION_LLM_PROVIDER=fake
SIM_EXPLANATION_LLM_BASE_URL=http://localhost:8080/v1
SIM_EXPLANATION_LLM_MODEL_NAME=Qwen3-4B
# One explanation is a few short paragraphs of prose, not a JSON turn.
SIM_EXPLANATION_MAX_TOKENS=400
# Lower than the caller generator's 0.7: an explanation cites given numbers, not a persona.
SIM_EXPLANATION_TEMPERATURE=0.2
SIM_EXPLANATION_TIMEOUT_MS=8000

# --- Full compose stack (`make up` / `make down`, E18-E; SPEC §36, HLD 60 §9) ------------------
# Host directory bind-mounted read-only into llama-server/voice-agent/tts-qwen3. Never baked into
# an image (SPEC §41). Recordings use a named Docker volume instead (`recordings-data`, R10 of the
# E18 brief) — not a host path — so no DATA_DIR is needed here.
# RELATIVE TO `infra/` (the compose file's directory), NOT to the repo root: compose resolves a
# relative bind-mount source against the compose file's own directory. The repo's `models/` is
# therefore `../models`; absolute paths work too. (`./models` mounts an empty `infra/models`.)
MODELS_DIR=../models
# GPU device selection for the nvidia container runtime (llama-server, voice-agent, tts-qwen3).
# `all` is fine on a single-GPU dev box; pin a specific index on a multi-GPU machine.
NVIDIA_VISIBLE_DEVICES=all
# Pinned ggml-org/llama.cpp CUDA server tag (docs/hld/60-inference-ops.md §8/§9) — pulled and its
# `--help`/`--version` captured for real (E19-F, 2026-09-22, build 11065 commit ce8caa6e6,
# `docs/benchmarks/results/llama-server-b11065-help.txt`): every flag
# `infra/scripts/llama-server-entrypoint.sh` spells (`--model`, `--alias`, `--host`, `--port`,
# `--ctx-size`, `--parallel`, `--n-gpu-layers`, `--batch-size`, `--ubatch-size`, `--flash-attn
# on|off|auto`, `--cache-type-k`/`-v`, `--threads`, `--jinja`, `--chat-template-kwargs`,
# `--metrics`) is accepted by this exact tag, spelled exactly as the entrypoint script spells it.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b11065
# Loopback-only inside the voice-agent container (R7 of the E18 brief); never published to the
# host. Used by `GET /preflight/asr` and `GET /preflight/tts` (preflight checks 5/6, SPEC §38).
SIM_VOICE_AGENT_HTTP_PORT=8113
