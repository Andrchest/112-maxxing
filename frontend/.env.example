# Dev-server proxy target for /api (REST commands plus the WebSocket upgrade at
# /api/v1/ws/sessions/{session_id}, HLD §40.1). Ports 8000 and 8001 on this machine belong to
# another project; this simulator's backend listens on 8100 by default
# (docs/hld/00-decisions.md D1, Makefile SIM_API_PORT).
VITE_API_PROXY_TARGET=http://127.0.0.1:8100

# Optional developer override for the phone widget's LiveKit signalling URL (SPEC §15, D9).
# Normally unset: `createVoiceToken` already returns a browser-facing `livekit_url` (the
# backend's `livekit_public_url` setting, E11-B). Set this only to point the widget at a
# different LiveKit instance for local dev; when set and non-empty it wins over the response.
# VITE_LIVEKIT_URL=ws://127.0.0.1:7880
