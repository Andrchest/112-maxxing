# Throwaway env file for `make compose-check` ONLY (`docker compose config -q`, never `up`).
# Never copy this into `.env` or use these values for a real run — SPEC §41 forbids a real secret
# in source, and these placeholders exist only so `docker compose config` can render the compose
# file's `${VAR}` interpolations without a developer's real `.env` present. Every secret here is
# >= 32 bytes, matching this epic's `SIM_JWT_SECRET` length rule (R3) so a future `config --quiet`
# strict-mode check never trips on this file specifically.
SIM_POSTGRES_USER=sim
SIM_POSTGRES_PASSWORD=compose-check-placeholder-not-a-real-secret-32b
SIM_POSTGRES_DB=sim
SIM_JWT_SECRET=compose-check-placeholder-jwt-secret-at-least-32-bytes-long
SIM_LIVEKIT_API_KEY=compose-check-placeholder-key
SIM_LIVEKIT_API_SECRET=compose-check-placeholder-livekit-secret-32-bytes-min
SIM_SEED_TRAINEE_PASSWORD=compose-check-placeholder
SIM_SEED_INSTRUCTOR_PASSWORD=compose-check-placeholder
SIM_SEED_ADMIN_PASSWORD=compose-check-placeholder
SIM_MODEL_PROFILE=DEV_3060TI
MODELS_DIR=../models
NVIDIA_VISIBLE_DEVICES=all
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b11065
